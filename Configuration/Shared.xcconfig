// Set the same group for App and Widget, and register it in your developer account.
CLAUDE_USAGE_APP_GROUP = group.local.ClaudeUsage
LLM_USAGE_APP_GROUP = $(CLAUDE_USAGE_APP_GROUP)
DEVELOPMENT_TEAM =
// Version fields are generated from Git by Scripts/build_version.py for every target.
// Developer builds do not contact the production update channel.
LLM_UPDATE_CHANNEL = development
LLM_UPDATE_PUBLIC_KEY =
#include? "UpdateSigning.xcconfig"
// Optional, ignored by Git: developer overrides.
#include? "Local.xcconfig"
